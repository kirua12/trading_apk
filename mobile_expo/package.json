{
  "name": "trading-android-companion",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android",
    "apk:local": "expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease",
    "apk:local:clean": "expo prebuild --platform android --no-install --clean && cd android && ./gradlew clean assembleRelease",
    "apk:cloud": "eas build --platform android --profile preview",
    "aab:cloud": "eas build --platform android --profile production"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "react": "18.2.0",
    "react-native": "0.74.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0"
  }
}
